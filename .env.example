# =============================================================================
# TDD Intelligence — Backend Environment Example
# =============================================================================

# ---- Flask & Security ----
FLASK_ENV=production
FLASK_DEBUG=false
SECRET_KEY=change-me-in-production
JWT_SECRET=change-me-in-production
JWT_ACCESS_MINUTES=60
JWT_REFRESH_DAYS=7

# ---- MySQL Database ----
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_DATABASE=tdd_intelligence
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_ROOT_PASSWORD=rootpass
MYSQL_POOL_SIZE=5

# ---- Redis / Celery ----
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# ---- CORS ----
CORS_ORIGINS=http://localhost:8080,http://localhost:5173

# ---- LLM Provider (Google Gemini) ----
# Set LLM_PROVIDER to "gemini" to use live Gemini API, or "mock" for offline mock testing
LLM_PROVIDER=mock
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# ---- RAG / Vector Store & Embeddings ----
# VECTOR_STORE options: mock | chromadb
VECTOR_STORE=mock
CHROMA_PATH=./.chroma
EMBEDDING_MODEL=all-MiniLM-L6-v2
UPLOAD_PATH=data/uploads

# ---- Deterministic Tool Adapters ----
API_RUNNER=mock
CODE_ANALYZER=mock
ALM_PROVIDER=mock

# ---- Observability & Tracing ----
OTEL_EXPORTER=console
OTEL_SERVICE_NAME=tdd-intelligence-backend

# ---- Workflow Configuration ----
WORKFLOW_MAX_RETRIES=3
